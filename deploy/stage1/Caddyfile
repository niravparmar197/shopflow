# Caddy: HTTPS with automatic Let's Encrypt certificates (and renewals) for the
# DuckDNS name, then reverse proxy to the gateway (API) and the web app (UI).
# The ONLY public entry point.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	# `route` keeps the rules in EXACTLY this order (Caddy re-sorts them otherwise).
	route {
		# Never public: Prometheus scrapes /metrics on the private network, and
		# /internal/* is service-to-service only.
		@private path_regexp private ^/(metrics|internal)(/|$)|/internal/
		respond @private 404

		# Swagger UI + admin UIs: username "admin", password = SSM ADMIN_PASSWORD.
		@admin path /docs /docs/* /jaeger /jaeger/* /mail /mail/*
		basic_auth @admin {
			admin {$ADMIN_PASSWORD_HASH}
		}

		handle /jaeger* {
			reverse_proxy jaeger:16686
		}
		handle /mail* {
			reverse_proxy mailpit:8025
		}
		# Grafana has its own login (admin / SSM GRAFANA_ADMIN_PASSWORD).
		handle /grafana* {
			reverse_proxy grafana:3000
		}
		# Product images: /assets/products/<key> -> MinIO (only products/ is public-read).
		# ONLY /assets/products/*: the web app's own hashed files are /assets/*.js too.
		handle_path /assets/products/* {
			rewrite * /shopflow-products/products{uri}
			reverse_proxy minio:9000
		}
		# The API: versioned routes, health probes and Swagger.
		# Caddy sets X-Forwarded-For; the gateway trusts 1 hop.
		@api path /v1/* /health /health/* /docs /docs/*
		handle @api {
			reverse_proxy gateway:3000
		}
		# Everything else is the web app (shell + micro frontends, nginx). Same
		# origin as /v1, so the httpOnly refresh cookie (SameSite=strict) works.
		handle {
			reverse_proxy web:8080
		}
	}
}
