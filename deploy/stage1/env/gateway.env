# Stage 1 (deploy/stage1/docker-compose.yml). NO secrets here: they come from SSM via
# /opt/shopflow/shared/.env and are injected in the compose `environment:` block.
NODE_ENV=production
SERVICE_NAME=gateway
PORT=3000
REDIS_URL=redis://redis:6379
USER_SERVICE_URL=http://user:3000
PRODUCT_SERVICE_URL=http://product:3000
ORDER_SERVICE_URL=http://order:3000
INVENTORY_SERVICE_URL=http://inventory:3000
PAYMENT_SERVICE_URL=http://payment:3000
NOTIFICATION_SERVICE_URL=http://notification:3000
PRODUCT_GRPC_URL=product:50052
JWT_PUBLIC_KEY_PATH=/run/keys/jwt-public.pem
# Caddy is the one proxy in front: trust exactly 1 X-Forwarded-For hop.
TRUST_PROXY_HOPS=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=info
