# Stage 1 DEMO: the fake provider (no real money). The fake provider and its dev
# webhook only run outside NODE_ENV=production, so this ONE service stays
# "development". With real Stripe/Razorpay keys: NODE_ENV=production +
# PAYMENT_PROVIDER=stripe and the keys in SSM. See docs/deploy-stage1.md.
NODE_ENV=development
PAYMENT_PROVIDER=fake
SERVICE_NAME=payment
PORT=3000
KAFKA_BROKERS=kafka:29092
JWT_PUBLIC_KEY_PATH=/run/keys/jwt-public.pem
PAYMENT_TTL_MINUTES=15
PAYMENT_SWEEPER_ENABLED=true
PAYMENT_SWEEP_MS=30000
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=info
