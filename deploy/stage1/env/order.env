# Stage 1. DATABASE_URL + INTERNAL_API_TOKEN are injected by compose from SSM.
NODE_ENV=production
SERVICE_NAME=order
PORT=3000
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:29092
JWT_PUBLIC_KEY_PATH=/run/keys/jwt-public.pem
PRODUCT_GRPC_URL=product:50052
INVENTORY_SERVICE_URL=http://inventory:3000
FLASH_BULKHEAD_MAX=50
FLASH_BULKHEAD_QUEUE=200
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=info
