# Stage 1. Images stay on the box (MinIO); keys + ASSET_BASE_URL are injected by compose.
NODE_ENV=production
SERVICE_NAME=product
PORT=3000
GRPC_PORT=50052
MONGO_URL=mongodb://mongo:27017/products_db
REDIS_URL=redis://redis:6379
JWT_PUBLIC_KEY_PATH=/run/keys/jwt-public.pem
S3_BUCKET=shopflow-products
S3_REGION=ap-southeast-2
S3_ENDPOINT=http://minio:9000
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=info
MONGO_AUTO_INDEX=true
