# Stage 1. No secrets here (DATABASE_URL is injected by compose from SSM).
NODE_ENV=production
SERVICE_NAME=user
PORT=3000
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:29092 # account emails go out as events (Phase 2 P3)
JWT_PRIVATE_KEY_PATH=/run/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/keys/jwt-public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=info
