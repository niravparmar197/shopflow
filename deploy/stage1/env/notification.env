# Stage 1. Emails go to the Mailpit demo inbox (https://<domain>/mail), or to
# Amazon SES once MAIL_FROM is in SSM (docker-compose.yml, Phase 2 P4).
NODE_ENV=production
SERVICE_NAME=notification
PORT=3000
MONGO_URL=mongodb://mongo:27017/notifications_db
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:29092
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM="ShopFlow <no-reply@shopflow.local>"
JWT_PUBLIC_KEY_PATH=/run/keys/jwt-public.pem
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=info
MONGO_AUTO_INDEX=true
