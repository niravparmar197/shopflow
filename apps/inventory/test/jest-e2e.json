{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../..",
  "testRegex": "apps/inventory/test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "node_modules.@nestjs.(config|jwt|mapped-types|mongoose|schedule|terminus|typeorm).+\\.js$": [
      "babel-jest",
      {
        "plugins": [
          "./tools/jest/rename-esm-require.js",
          "babel-plugin-transform-import-meta",
          "@babel/plugin-transform-modules-commonjs"
        ]
      }
    ],
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!@nestjs/(config|jwt|mapped-types|mongoose|schedule|terminus|typeorm)/)"
  ],
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
    "^@app/events(|/.*)$": "<rootDir>/libs/events/src/$1",
    "^@app/kafka(|/.*)$": "<rootDir>/libs/kafka/src/$1",
    "^@app/proto(|/.*)$": "<rootDir>/libs/proto/src/$1",
    "^@app/scheduler(|/.*)$": "<rootDir>/libs/scheduler/src/$1",
    "^@app/observability(|/.*)$": "<rootDir>/libs/observability/src/$1"
  },
  "testTimeout": 180000,
  "globalSetup": "<rootDir>/apps/inventory/test/e2e-setup.ts",
  "globalTeardown": "<rootDir>/apps/inventory/test/e2e-teardown.ts"
}
