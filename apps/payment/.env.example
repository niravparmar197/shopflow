NODE_ENV=development
SERVICE_NAME=payment
PORT=3004
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5434/payments_db
KAFKA_BROKERS=localhost:9092
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
# razorpay | stripe | fake (fake: local dev and tests only)
PAYMENT_PROVIDER=fake
PAYMENT_TTL_MINUTES=15
# Any long random string, e.g. node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
FAKE_WEBHOOK_SECRET=
# Test-mode keys go in .env only; never commit them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
