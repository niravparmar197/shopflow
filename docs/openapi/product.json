{
  "openapi": "3.0.0",
  "paths": {
    "/v1/products": {
      "post": {
        "operationId": "ProductsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN (admins only)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "CONFLICT (slug already exists)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Admin – Products"
        ]
      }
    },
    "/v1/products/{id}": {
      "patch": {
        "operationId": "ProductsController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/Function"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN (admins only)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "CONFLICT (changed by someone else: reload and retry; or slug taken)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update a product",
        "tags": [
          "Admin – Products"
        ]
      }
    },
    "/v1/products/{id}/images/upload-url": {
      "post": {
        "operationId": "ImagesController_uploadUrl",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/Function"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadUrlDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          },
          "400": {
            "description": "BAD_REQUEST (validation, or the product has the maximum number of images)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN (admins only)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Step 1: a presigned POST to upload the file straight to S3",
        "tags": [
          "Admin – Products"
        ]
      }
    },
    "/v1/products/{id}/images/confirm": {
      "post": {
        "operationId": "ImagesController_confirm",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/Function"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmImageDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST (upload not found or expired, wrong key, or not a valid image)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN (admins only)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Step 2: after the upload, check the file and attach it to the product",
        "tags": [
          "Admin – Products"
        ]
      }
    }
  },
  "info": {
    "title": "ShopFlow – Products (admin)",
    "description": "",
    "version": "exported",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 0,
            "maxLength": 5000
          },
          "category": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "pricePaise": {
            "type": "number",
            "minimum": 0
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "name",
          "slug",
          "category",
          "pricePaise"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable code, e.g. SOLD_OUT, PRICE_CHANGED, or the status name (CONFLICT)"
          },
          "message": {
            "type": "string",
            "description": "Human-readable message (\"Validation failed\" for invalid input)"
          },
          "details": {
            "type": "object",
            "description": "Validation messages, or extra data, e.g. { retryAfterSec } for SERVER_BUSY"
          },
          "correlationId": {
            "type": "string",
            "description": "Echo of the x-correlation-id header (or a new one); quote it in bug reports"
          },
          "traceId": {
            "type": "string",
            "description": "Paste into Jaeger to see the whole request (absent if not traced)"
          }
        },
        "required": [
          "code",
          "message",
          "correlationId"
        ]
      },
      "Function": {
        "type": "object",
        "properties": {}
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "version"
        ]
      },
      "UploadUrlDto": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "sizeBytes": {
            "type": "number",
            "minimum": 1,
            "maximum": 5242880
          }
        },
        "required": [
          "contentType",
          "sizeBytes"
        ]
      },
      "ConfirmImageDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^tmp\\/[a-f0-9]{24}\\/[a-f0-9-]{36}\\.(jpg|png|webp)$"
          }
        },
        "required": [
          "key"
        ]
      }
    }
  }
}
