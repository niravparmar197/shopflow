{
  "openapi": "3.0.0",
  "paths": {
    "/v1/products": {
      "get": {
        "operationId": "ProductsController_list",
        "parameters": [
          {
            "name": "category",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 50,
              "type": "string"
            }
          },
          {
            "name": "minPrice",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "type": "number"
            }
          },
          {
            "name": "maxPrice",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "type": "number"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "items[] + nextCursor (null on the last page)"
          },
          "400": {
            "description": "BAD_REQUEST (validation or invalid cursor)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE (product service down)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "504": {
            "description": "GATEWAY_TIMEOUT (no answer within 2 s)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Browse the catalog: filters, search, cursor paging (public)",
        "tags": [
          "Products"
        ]
      }
    },
    "/v1/products/{idOrSlug}": {
      "get": {
        "operationId": "ProductsController_get",
        "parameters": [
          {
            "name": "idOrSlug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE (product service down)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "504": {
            "description": "GATEWAY_TIMEOUT (no answer within 2 s)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "One product by id or slug (public)",
        "tags": [
          "Products"
        ]
      }
    }
  },
  "info": {
    "title": "ShopFlow – Gateway",
    "description": "",
    "version": "exported",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable code, e.g. SOLD_OUT, PRICE_CHANGED, or the status name (CONFLICT)"
          },
          "message": {
            "type": "string",
            "description": "Human-readable message (\"Validation failed\" for invalid input)"
          },
          "details": {
            "type": "object",
            "description": "Validation messages, or extra data, e.g. { retryAfterSec } for SERVER_BUSY"
          },
          "correlationId": {
            "type": "string",
            "description": "Echo of the x-correlation-id header (or a new one); quote it in bug reports"
          },
          "traceId": {
            "type": "string",
            "description": "Paste into Jaeger to see the whole request (absent if not traced)"
          }
        },
        "required": [
          "code",
          "message",
          "correlationId"
        ]
      }
    }
  }
}
