{
  "openapi": "3.0.0",
  "paths": {
    "/v1/inventory/stock/{productId}": {
      "put": {
        "operationId": "StockController_set",
        "parameters": [
          {
            "name": "productId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetStockDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Sets what can be sold now; reserved holds are left as they are.",
        "tags": [
          "Admin � Stock"
        ]
      },
      "get": {
        "operationId": "StockController_get",
        "parameters": [
          {
            "name": "productId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "404": {
            "description": "STOCK_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Available and reserved units",
        "tags": [
          "Admin � Stock"
        ]
      }
    },
    "/v1/inventory/flash-sales": {
      "post": {
        "operationId": "FlashSaleAdminController_start",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSaleDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "NOT_ENOUGH_STOCK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "SALE_ACTIVE (one sale per product at a time)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Start a flash sale: moves the units from stock into the sale",
        "tags": [
          "Admin � Flash sales"
        ]
      }
    },
    "/v1/inventory/flash-sales/{productId}": {
      "get": {
        "operationId": "FlashSaleAdminController_status",
        "parameters": [
          {
            "name": "productId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "FLASH_SALE_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Units left, end time",
        "tags": [
          "Admin � Flash sales"
        ]
      },
      "delete": {
        "operationId": "FlashSaleAdminController_end",
        "parameters": [
          {
            "name": "productId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Ended"
          },
          "404": {
            "description": "FLASH_SALE_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "End the sale early; unsold units go back to stock",
        "tags": [
          "Admin � Flash sales"
        ]
      }
    }
  },
  "info": {
    "title": "ShopFlow – Inventory (admin)",
    "description": "",
    "version": "exported",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SetStockDto": {
        "type": "object",
        "properties": {
          "available": {
            "type": "number",
            "description": "Units that can be sold now; reserved holds are left as they are",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "required": [
          "available"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable code, e.g. SOLD_OUT, PRICE_CHANGED, or the status name (CONFLICT)"
          },
          "message": {
            "type": "string",
            "description": "Human-readable message (\"Validation failed\" for invalid input)"
          },
          "details": {
            "type": "object",
            "description": "Validation messages, or extra data, e.g. { retryAfterSec } for SERVER_BUSY"
          },
          "correlationId": {
            "type": "string",
            "description": "Echo of the x-correlation-id header (or a new one); quote it in bug reports"
          },
          "traceId": {
            "type": "string",
            "description": "Paste into Jaeger to see the whole request (absent if not traced)"
          }
        },
        "required": [
          "code",
          "message",
          "correlationId"
        ]
      },
      "StartSaleDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "description": "Units on sale (taken from available stock)",
            "minimum": 1
          },
          "durationMinutes": {
            "type": "number",
            "description": "How long the sale runs, at most 24 h",
            "minimum": 1,
            "maximum": 1440
          }
        },
        "required": [
          "productId",
          "quantity",
          "durationMinutes"
        ]
      }
    }
  }
}
