              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Status timeline of one order.\n\nFrom the read model; GET /orders/:id below stays on the write model.",
        "tags": [
          "Orders"
        ]
      }
    },
    "/v1/orders/{id}": {
      "get": {
        "operationId": "OrdersController_getOne",
