                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "One order with its items (the write model: always current)",
        "tags": [
          "Orders"
        ]
      }
    }
  },
  "info": {
    "title": "ShopFlow – Orders & Cart",
    "description": "",
    "version": "exported",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable code, e.g. SOLD_OUT, PRICE_CHANGED, or the status name (CONFLICT)"
          },
          "message": {
            "type": "string",
            "description": "Human-readable message (\"Validation failed\" for invalid input)"
          },
          "details": {
            "type": "object",
            "description": "Validation messages, or extra data, e.g. { retryAfterSec } for SERVER_BUSY"
          },
          "correlationId": {
            "type": "string",
            "description": "Echo of the x-correlation-id header (or a new one); quote it in bug reports"
          },
          "traceId": {
            "type": "string",
            "description": "Paste into Jaeger to see the whole request (absent if not traced)"
          }
        },
        "required": [
          "code",
          "message",
          "correlationId"
        ]
      },
      "AddItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "qty": {
            "type": "number",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "productId",
          "qty"
        ]
      },
      "UpdateQtyDto": {
        "type": "object",
        "properties": {
          "qty": {
            "type": "number",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "qty"
        ]
      },
      "ApplyCouponDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "CreateCouponDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "PERCENT",
              "FLAT"
            ]
          },
          "value": {
            "type": "number",
            "minimum": 1
          },
          "maxDiscountPaise": {
            "type": "number",
            "minimum": 1
          },
          "minCartPaise": {
            "type": "number",
            "minimum": 0
          },
          "category": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "firstOrderOnly": {
            "type": "boolean"
          },
          "validFrom": {
            "format": "date-time",
            "type": "string"
          },
          "validTo": {
            "format": "date-time",
            "type": "string"
          },
          "usageLimit": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "code",
          "type",
          "value",
          "validFrom",
          "validTo"
        ]
      },
      "Coupon": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "type": {
            "enum": [
              "PERCENT",
              "FLAT"
            ],
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "maxDiscountPaise": {
            "type": "number",
            "nullable": true
          },
          "minCartPaise": {
            "type": "number"
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "firstOrderOnly": {
            "type": "boolean"
          },
          "validFrom": {
            "format": "date-time",
            "type": "string"
          },
          "validTo": {
            "format": "date-time",
            "type": "string"
          },
          "usageLimit": {
            "type": "number",
            "nullable": true
          },
          "usedCount": {
            "type": "number"
          },
          "isActive": {
            "type": "boolean"
          },
          "version": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "type",
          "value",
          "maxDiscountPaise",
          "minCartPaise",
          "category",
          "firstOrderOnly",
          "validFrom",
          "validTo",
          "usageLimit",
          "usedCount",
          "isActive",
          "version",
          "createdAt"
        ]
      },
      "PlaceOrderDto": {
        "type": "object",
        "properties": {
          "expectedTotalPaise": {
            "type": "number",
            "description": "The total shown to the user; checkout fails with PRICE_CHANGED if the\nreal total differs.",
            "minimum": 0
          }
        }
      }
    }
  }
}
