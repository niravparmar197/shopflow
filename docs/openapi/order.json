    "/v1/orders": {
      "post": {
        "operationId": "OrdersController_place",
        "parameters": [
          {
            "name": "x-correlation-id",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "8–100 chars (letters, digits, - _). Send the SAME key when you retry, so you never get 2 orders. A replay answers with the header Idempotent-Replayed: true.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceOrderDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created with status PENDING. Stock is reserved in the background."
          },
          "400": {
            "description": "IDEMPOTENCY_KEY_REQUIRED | IDEMPOTENCY_KEY_INVALID | BAD_REQUEST (validation)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED (missing or expired token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "PRICE_CHANGED | CART_ITEM_UNAVAILABLE | COUPON_NOT_APPLICABLE | COUPON_EXHAUSTED | SOLD_OUT | ALREADY_BOUGHT_IN_SALE | CHECKOUT_IN_PROGRESS | IDEMPOTENCY_IN_PROGRESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "CART_EMPTY | IDEMPOTENCY_KEY_REUSED | FLASH_LIMIT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED (per user, at the gateway) | SERVER_BUSY (flash sale); see the Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE (product catalog down; nothing was saved, safe to retry)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Place an order from your cart.\n\nA double click or a retry must not create a second order: the client\nsends the same Idempotency-Key each time and gets the first result back.",
        "tags": [
          "Orders"
        ]
      },
      "get": {
        "operationId": "OrdersController_list",
        "parameters": [
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "items[] + nextCursor. Orders from the last few seconds may have syncing: true."
          },
          "400": {
            "description": "INVALID_CURSOR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED (missing or expired token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "My orders, newest first (from the read model)",
        "tags": [
          "Orders"
        ]
      }
    },
    "/v1/orders/{id}/tracking": {
      "get": {
        "operationId": "OrdersController_tracking",
        "parameters": [
