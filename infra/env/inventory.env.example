# Docker Compose (infra/docker-compose.prod.yml). Hostnames are compose
# service names; every app listens on 3000 inside its container.
# Copy to infra/env/inventory.env (git-ignored) and fill in the secrets.
SERVICE_NAME=inventory
PORT=3000
DATABASE_URL=postgresql://shop:shop@postgres:5432/inventory_db
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:29092
JWT_PUBLIC_KEY_PATH=/run/keys/jwt-public.pem
# Same value as in order.env
INTERNAL_API_TOKEN=change-me-same-long-random-value-in-order-and-inventory
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=info
