# Docker Compose (infra/docker-compose.prod.yml). Hostnames are compose
# service names; every app listens on 3000 inside its container.
# Copy to infra/env/product.env (git-ignored) and fill in the secrets.
SERVICE_NAME=product
PORT=3000
GRPC_PORT=50052
# Reviews (Phase 2 P5): only buyers may review; product asks order.
ORDER_SERVICE_URL=http://order:3000
INTERNAL_API_TOKEN=change-me-same-long-random-value-in-order-and-inventory
MONGO_URL=mongodb://mongo:27017/products_db
REDIS_URL=redis://redis:6379
JWT_PUBLIC_KEY_PATH=/run/keys/jwt-public.pem
# MinIO locally. On AWS: drop S3_ENDPOINT and the keys; the IAM role is used.
# Presigned upload URLs point at minio:9000, which only resolves inside Docker.
S3_BUCKET=shopflow-products
S3_REGION=ap-south-1
S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
ASSET_BASE_URL=http://localhost:9002/shopflow-products
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=info
