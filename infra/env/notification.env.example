# Docker Compose (infra/docker-compose.prod.yml). Hostnames are compose
# service names; every app listens on 3000 inside its container.
# Copy to infra/env/notification.env (git-ignored) and fill in the secrets.
SERVICE_NAME=notification
PORT=3000
MONGO_URL=mongodb://mongo:27017/notifications_db
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:29092
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM="ShopFlow <no-reply@shopflow.local>"
JWT_PUBLIC_KEY_PATH=/run/keys/jwt-public.pem
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=info
WEB_URL=http://localhost:5000 # links in reset / verify emails
