# Docker Compose (infra/docker-compose.prod.yml). Hostnames are compose
# service names; every app listens on 3000 inside its container.
# Copy to infra/env/payment.env (git-ignored) and fill in the secrets.
SERVICE_NAME=payment
PORT=3000
# LOCAL COMPOSE ONLY: the fake provider refuses to start under production
# (anyone with its secret could mark orders paid), and the dev webhook
# endpoint used for the manual checkout test only exists outside production.
# A real deploy uses NODE_ENV=production with stripe or razorpay keys.
NODE_ENV=development
PAYMENT_PROVIDER=fake
FAKE_WEBHOOK_SECRET=change-me-long-random
DATABASE_URL=postgresql://shop:shop@postgres:5432/payments_db
KAFKA_BROKERS=kafka:29092
JWT_PUBLIC_KEY_PATH=/run/keys/jwt-public.pem
PAYMENT_TTL_MINUTES=15
PAYMENT_SWEEPER_ENABLED=true
PAYMENT_SWEEP_MS=30000
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=info
