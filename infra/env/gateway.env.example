# Docker Compose (infra/docker-compose.prod.yml). Hostnames are compose
# service names; every app listens on 3000 inside its container.
# Copy to infra/env/gateway.env (git-ignored) and fill in the secrets.
SERVICE_NAME=gateway
PORT=3000
REDIS_URL=redis://redis:6379
USER_SERVICE_URL=http://user:3000
PRODUCT_SERVICE_URL=http://product:3000
ORDER_SERVICE_URL=http://order:3000
INVENTORY_SERVICE_URL=http://inventory:3000
PAYMENT_SERVICE_URL=http://payment:3000
NOTIFICATION_SERVICE_URL=http://notification:3000
PRODUCT_GRPC_URL=product:50052
JWT_PUBLIC_KEY_PATH=/run/keys/jwt-public.pem
CORS_ORIGINS=http://localhost:5173
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=info
