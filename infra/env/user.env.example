# Docker Compose (infra/docker-compose.prod.yml). Hostnames are compose
# service names; every app listens on 3000 inside its container.
# Copy to infra/env/user.env (git-ignored) and fill in the secrets.
SERVICE_NAME=user
PORT=3000
DATABASE_URL=postgresql://shop:shop@postgres:5432/users_db
REDIS_URL=redis://redis:6379
JWT_PRIVATE_KEY_PATH=/run/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/keys/jwt-public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=info
