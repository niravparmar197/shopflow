{
  "title": "ShopFlow Overview",
  "uid": "shopflow-overview",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "Orders / min",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "sum(rate(shopflow_orders_placed_total[5m])) * 60"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Revenue / hour (₹)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "sum(increase(shopflow_revenue_paise_total[1h])) / 100"
        }
      ]
    },
    {
      "type": "stat",
      "title": "DLQ messages (1h)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "sum(increase(kafka_messages_processed_total{result=\"dlq\"}[1h]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Paid w/o reservation (24h)",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "sum(increase(shopflow_paid_without_reservation_total[24h]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests / s by service",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_request_duration_seconds_count[1m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx error % by service",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_request_duration_seconds_count{status_code=~\"5..\"}[5m])) / sum by (service) (rate(http_server_request_duration_seconds_count[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by service",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Order status changes / min",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "sum by (to, reason) (rate(shopflow_order_transitions_total[5m])) * 60",
          "legendFormat": "{{to}} {{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox oldest pending (s)",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "max by (service) (outbox_oldest_pending_age_seconds)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer results / s",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "sum by (group, result) (rate(kafka_messages_processed_total[1m]))",
          "legendFormat": "{{group}} {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event-loop lag p99",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "max by (service) (nodejs_eventloop_lag_p99_seconds)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Checkouts refused / min by code",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(shopflow_checkout_rejected_total[5m])) * 60",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Flash gate answers / s",
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(shopflow_flash_gate_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ]
}
