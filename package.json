{
  "name": "shopflow",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/gateway/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npm run test:e2e:gateway && npm run test:e2e:user && npm run test:e2e:product && npm run test:e2e:order && npm run test:e2e:inventory && npm run test:e2e:payment && npm run test:e2e:notification",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate:user": "npm run typeorm -- migration:generate -d apps/user/src/database/data-source.ts",
    "migration:run:user": "npm run typeorm -- migration:run -d apps/user/src/database/data-source.ts",
    "migration:revert:user": "npm run typeorm -- migration:revert -d apps/user/src/database/data-source.ts",
    "migration:generate:order": "npm run typeorm -- migration:generate -d apps/order/src/database/data-source.ts",
    "migration:run:order": "npm run typeorm -- migration:run -d apps/order/src/database/data-source.ts",
    "migration:revert:order": "npm run typeorm -- migration:revert -d apps/order/src/database/data-source.ts",
    "migration:generate:inventory": "npm run typeorm -- migration:generate -d apps/inventory/src/database/data-source.ts",
    "migration:run:inventory": "npm run typeorm -- migration:run -d apps/inventory/src/database/data-source.ts",
    "migration:revert:inventory": "npm run typeorm -- migration:revert -d apps/inventory/src/database/data-source.ts",
    "migration:generate:payment": "npm run typeorm -- migration:generate -d apps/payment/src/database/data-source.ts",
    "migration:run:payment": "npm run typeorm -- migration:run -d apps/payment/src/database/data-source.ts",
    "migration:revert:payment": "npm run typeorm -- migration:revert -d apps/payment/src/database/data-source.ts",
    "test:e2e:user": "jest --config apps/user/test/jest-e2e.json --runInBand",
    "seed:product": "ts-node --transpile-only apps/product/src/seed.ts",
    "proto:gen": "node scripts/proto-gen.js",
    "kafka:topics": "node scripts/kafka-topics.js",
    "dlq:replay": "node scripts/dlq-replay.js",
    "test:e2e:product": "jest --config apps/product/test/jest-e2e.json --runInBand",
    "test:e2e:order": "jest --config apps/order/test/jest-e2e.json --runInBand",
    "test:e2e:inventory": "jest --config apps/inventory/test/jest-e2e.json --runInBand",
    "test:e2e:payment": "jest --config apps/payment/test/jest-e2e.json --runInBand",
    "test:e2e:notification": "jest --config apps/notification/test/jest-e2e.json --runInBand",
    "test:e2e:gateway": "jest --config apps/gateway/test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-presigned-post": "^3.1150.0",
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@bull-board/nestjs": "^9.10.4",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.14",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.11.2",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.0",
    "opossum": "^10.0.0",
    "p-retry": "^4.6.2",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "rate-limiter-flexible": "^11.2.1",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^23.0.0",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@protobuf-ts/protoc": "^2.11.1",
    "@testcontainers/kafka": "^12.2.0",
    "@testcontainers/mongodb": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^7.0.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.15.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "node_modules.@nestjs.(config|jwt|mapped-types|mongoose|terminus|typeorm).+\\.js$": [
        "babel-jest",
        {
          "plugins": [
            "./tools/jest/rename-esm-require.js",
            "babel-plugin-transform-import-meta",
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ],
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/events(|/.*)$": "<rootDir>/libs/events/src/$1",
      "^@app/kafka(|/.*)$": "<rootDir>/libs/kafka/src/$1",
      "^@app/proto(|/.*)$": "<rootDir>/libs/proto/src/$1",
      "^@app/resilience(|/.*)$": "<rootDir>/libs/resilience/src/$1",
      "^@app/scheduler(|/.*)$": "<rootDir>/libs/scheduler/src/$1",
      "^@app/observability(|/.*)$": "<rootDir>/libs/observability/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!@nestjs/(config|jwt|mapped-types|mongoose|terminus|typeorm)/)"
    ]
  },
  "engines": {
    "node": ">=22.12"
  },
  "config": {
    "protocVersion": "36.2"
  }
}
